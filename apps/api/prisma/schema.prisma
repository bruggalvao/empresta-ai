// empresta-ai data model. See docs/modelagem-dados.md for the diagram and decisions.
//
// Conventions: snake_case in the database (via @map/@@map), camelCase in code,
// uuid primary keys generated by Postgres, timestamptz for instants.
// Objects Prisma cannot model (partial indexes, CHECKs, RLS, triggers, FKs to
// auth.users) live as raw SQL in the migration, see prisma/migrations/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  EMPLOYEE
  OPERATIONS

  @@map("membership_role")
}

enum EquipmentCategory {
  NOTEBOOK
  MONITOR
  CABLE
  CAMERA
  ACCESSORY

  @@map("equipment_category")
}

// "Loaned" and "overdue" are NOT stored: they derive from an open loan
// (returned_at IS NULL) and its due_date. Only states a person sets by hand live here.
enum EquipmentStatus {
  AVAILABLE
  MAINTENANCE

  @@map("equipment_status")
}

model Tenant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String   @unique
  name           String
  loanLimit      Int      @default(3) @map("loan_limit")
  loanPeriodDays Int      @default(14) @map("loan_period_days")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships Membership[]
  equipment   Equipment[]
  loans       Loan[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

// One row per person, global across tenants. `userId` is the Supabase Auth user id;
// the FK to auth.users is added in raw SQL (Prisma does not model the auth schema).
model Profile {
  userId    String   @id @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships Membership[]
  returned    Loan[]       @relation("LoanReturnedBy")
  auditLogs   AuditLog[]

  @@map("profiles")
}

// Links a person to a tenant with a role. The tenant for a request comes from the JWT
// claim, resolved against this table.
model Membership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  loans   Loan[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Equipment {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  name      String
  category  EquipmentCategory
  // Asset tag ("patrimônio"). Null when not informed; unique per tenant when present.
  assetTag  String?           @map("asset_tag")
  status    EquipmentStatus   @default(AVAILABLE)
  // Free text; holds the maintenance note while status = MAINTENANCE.
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans  Loan[]

  // Target of composite FKs so a loan can never point at another tenant's equipment.
  @@unique([id, tenantId])
  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@map("equipment")
}

// A loan is open while returnedAt is null. Overdue = open and dueDate < today.
model Loan {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  equipmentId  String    @map("equipment_id") @db.Uuid
  borrowerId   String    @map("borrower_id") @db.Uuid
  loanedAt     DateTime  @default(now()) @map("loaned_at") @db.Timestamptz(6)
  // Calendar date (business day), loanedAt + tenant.loanPeriodDays at creation time.
  // "Today" for overdue checks is computed in America/Sao_Paulo, not UTC.
  dueDate      DateTime  @map("due_date") @db.Date
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz(6)
  // Who registered the return: the borrower (self-service) or Operations (counter).
  returnedById String?   @map("returned_by_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment  Equipment  @relation(fields: [equipmentId, tenantId], references: [id, tenantId])
  borrower   Membership @relation(fields: [tenantId, borrowerId], references: [tenantId, userId])
  returnedBy Profile?   @relation("LoanReturnedBy", fields: [returnedById], references: [userId])

  @@index([tenantId, borrowerId])
  @@index([equipmentId])
  @@index([tenantId, dueDate])
  @@map("loans")
}

// Append-only (enforced by trigger in the migration). actorId is null for system actions.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Restrict, not Cascade/SetNull: the append-only trigger rejects the UPDATE/DELETE
  // those actions would perform, so tenants and people with history cannot be hard-deleted.
  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  Profile? @relation(fields: [actorId], references: [userId], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// Fixed-window counters for rate limiting (ADR 001 §2.10). Not tenant-scoped: keys are
// IPs or user ids. Old windows are pruned by the API.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limits")
}
