{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/vite/bin/vite.js",
        "apps/web",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
